<div class="page-header"><div class="page-header-inner">
  <div class="eyebrow">// Forward Engineering</div>
  <h1 class="sh">Development Roadmap</h1>
  <p class="ss">Prioritised from 70 years of operational and failure data. Engineering planning, not marketing.</p>
</div></div>
<section class="section">
  <div class="failure-preview-grid" style="grid-template-columns:1fr 1fr">
    {{#each roadmapPriorities}}
    <div class="failure-preview-card">
      <div class="fp-header">
        <span class="tag tag-{{color}}">{{priority}} · {{priorityLabel}}</span>
        <span class="mono" style="font-size:.62rem;color:var(--paper3)">{{suitCount}} suits</span>
      </div>
      <div class="fp-program">{{label}}</div>
      <p class="fp-failure">{{description}}</p>
      {{#if cases.length}}
      <div style="margin-top:.75rem;padding:.6rem .75rem;background:rgba(255,255,255,.03);border-left:2px solid rgba(255,255,255,.1)">
        <div class="mono" style="font-size:.58rem;color:var(--paper3);letter-spacing:.08em;margin-bottom:.4rem">LINKED FAILURE CASES</div>
        {{#each cases}}
        <div style="font-size:.72rem;margin-top:.35rem;color:var(--paper2)">
          <span class="mono" style="color:var(--paper3)">{{id}}</span> — {{truncate failure 90}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      <div class="fp-header" style="margin-top:1rem"><span style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--cyan)">0–3yr</span></div>
      <p class="fp-lesson">{{h1}}</p>
      {{#if h2}}
      <div class="fp-header" style="margin-top:.75rem"><span style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--cyan)">3–7yr</span></div>
      <p class="fp-lesson">{{h2}}</p>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
