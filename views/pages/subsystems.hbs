<div class="page-header"><div class="page-header-inner">
  <div class="eyebrow">// Technical Subsystem Analysis</div>
  <h1 class="sh">{{subsystemCount}} Subsystems.<br>70 Years of Iteration.</h1>
  <p class="ss">Each traced from first-generation failures through to current state and recommended next steps</p>
</div></div>
<section class="section">
  <div class="db-grid">
    {{#each subsystems}}
    <div class="db-card">
      <div class="db-card-top"><span class="tag tag-{{color}}">{{label}}</span></div>
      <h3 class="db-card-name {{color}}">{{label}}</h3>
      <p class="db-lesson">{{description}}</p>
      <div class="mono" style="font-size:.68rem;color:var(--paper3);margin-top:.9rem;line-height:1.6">
        <span style="color:var(--paper2)">{{count}} suits tagged —</span>
        {{#each examples}}<a href="/suits/{{slug}}" style="color:var(--cyan);text-decoration:none">{{name}}</a>{{#unless @last}}, {{/unless}}{{/each}}
      </div>
    </div>
    {{/each}}
  </div>
</section>
