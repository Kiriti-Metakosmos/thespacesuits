<div class="page-header">
  <div class="page-header-inner">
    <div class="eyebrow">// Variant Master Database</div>
    <h1 class="sh">Suit Database</h1>
    <p class="ss">{{totalCount}} suits displayed · filter by nation or category</p>
    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Nation:</span>
        <button class="filter-btn active" data-filter-nation="all">All</button>
        <button class="filter-btn" data-filter-nation="us">US / NASA</button>
        <button class="filter-btn" data-filter-nation="soviet">Soviet / Russia</button>
        <button class="filter-btn" data-filter-nation="china">China / CMSA</button>
        <button class="filter-btn" data-filter-nation="esa">Europe / ESA</button>
      </div>
      <div class="filter-group">
        <span class="filter-label">Category:</span>
        <button class="filter-btn active" data-filter-category="all">All</button>
        <button class="filter-btn" data-filter-category="IVA">IVA</button>
        <button class="filter-btn" data-filter-category="IEVA">IEVA</button>
        <button class="filter-btn" data-filter-category="EVA">EVA</button>
        <button class="filter-btn" data-filter-category="Prototype">Prototypes</button>
      </div>
    </div>
  </div>
</div>
<div class="section">
  <div class="db-grid">
    {{#each suits}}{{> suit-card}}{{/each}}
  </div>
</div>
