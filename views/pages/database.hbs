<div class="page-header">
  <div class="page-header-inner">
    <div class="eyebrow">// Variant Master Database</div>
    <h1 class="sh">Suit Database</h1>
    <p class="ss">{{totalCount}} suits displayed · filter by nation or category</p>
    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Nation:</span>
        <a href="/database" class="filter-btn {{#if (eq nation 'all')}}active{{/if}}">All</a>
        <a href="/database?nation=us" class="filter-btn {{#if (eq nation 'us')}}active{{/if}}">US / NASA</a>
        <a href="/database?nation=soviet" class="filter-btn {{#if (eq nation 'soviet')}}active{{/if}}">Soviet / Russia</a>
        <a href="/database?nation=china" class="filter-btn {{#if (eq nation 'china')}}active{{/if}}">China / CMSA</a>
        <a href="/database?nation=esa" class="filter-btn {{#if (eq nation 'esa')}}active{{/if}}">Europe / ESA</a>
      </div>
      <div class="filter-group">
        <span class="filter-label">Category:</span>
        <a href="/database" class="filter-btn {{#if (eq category 'all')}}active{{/if}}">All</a>
        <a href="/database?category=IVA" class="filter-btn {{#if (eq category 'IVA')}}active{{/if}}">IVA</a>
        <a href="/database?category=IEVA" class="filter-btn {{#if (eq category 'IEVA')}}active{{/if}}">IEVA</a>
        <a href="/database?category=EVA" class="filter-btn {{#if (eq category 'EVA')}}active{{/if}}">EVA</a>
      </div>
    </div>
  </div>
</div>
<div class="section">
  <div class="db-grid">
    {{#each suits}}{{> suit-card}}{{/each}}
  </div>
</div>
