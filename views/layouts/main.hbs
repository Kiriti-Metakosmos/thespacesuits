<!-- ── JSON-LD Structured Data ── -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "The Spacesuits",
  "url": "https://thespacesuits.com",
  "description": "Definitive engineering archive of US, Soviet and Russian spacesuit programs. 40+ variants, 70 years, real failure cases.",
  "publisher": {
    "@type": "Organization",
    "name": "Metakosmos Group",
    "url": "https://thespacesuits.com"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://thespacesuits.com/database?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

