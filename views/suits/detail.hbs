<div class="suit-detail-hero suit-hero--{{color}}">
  <div class="suit-detail-inner">
    <div class="suit-detail-meta">
      <div class="eyebrow">// {{variantId}} · {{nationLabel nation}}</div>
      <h1 class="suit-detail-name">{{name}}</h1>
      <div class="suit-detail-sub">{{manufacturer}} · {{era}}</div>
      <div class="suit-detail-tags">
        <span class="tag tag-{{nationColor nation}}">{{category}}</span>
        <span class="tag" style="color:var(--paper3)">{{status}}</span>
      </div>
    </div>
  </div>
</div>

<section class="section">
  <div class="suit-detail-grid">
    <div class="suit-detail-specs-col">
      <h2 class="sh" style="font-size:1.8rem">Technical Specifications</h2>
      <table class="spec-table">
        <tbody>
          <tr><td>Pressure</td><td class="mono">{{formatPressure this}}</td></tr>
          <tr><td>Suit mass (1g)</td><td class="mono">{{formatMass this}}</td></tr>
          <tr><td>Life support (primary)</td><td class="mono">{{lssPrimary}}</td></tr>
          <tr><td>Life support (backup)</td><td class="mono">{{or lssBackup '—'}}</td></tr>
          <tr><td>EVA duration</td><td class="mono">{{formatEVA evaDurationHr}}</td></tr>
          <tr><td>Program</td><td class="mono">{{program}}</td></tr>
          <tr><td>Agency</td><td class="mono">{{agency}}</td></tr>
          <tr><td>Manufacturer</td><td class="mono">{{manufacturer}}</td></tr>
          <tr><td>First use</td><td class="mono">{{or firstUse 'TBD'}}</td></tr>
          <tr><td>Status</td><td class="mono">{{status}}</td></tr>
          <tr><td>Donning / entry</td><td class="mono">{{entryDonning}}</td></tr>
        </tbody>
      </table>

      <div class="share-block">
        <div class="eyebrow" style="margin-bottom:1rem">// Share this page</div>
        <div class="share-buttons">
          <a href="https://twitter.com/intent/tweet?text={{name}}+spacesuit+archive+%7C+The+Spacesuits&url={{meta.canonical}}&via=thespacesuits" target="_blank" rel="noopener noreferrer" class="share-btn share-x" aria-label="Share on X / Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            Share on X
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{meta.canonical}}" target="_blank" rel="noopener noreferrer" class="share-btn share-li" aria-label="Share on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            Share on LinkedIn
          </a>
          <button class="share-btn share-copy" onclick="navigator.clipboard.writeText(window.location.href)" aria-label="Copy link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copy Link
          </button>
        </div>
      </div>
    </div>

    <div class="suit-detail-content-col">
      <h2 class="sh" style="font-size:1.8rem;margin-bottom:1.5rem">Engineering Analysis</h2>
      <div class="detail-block">
        <div class="detail-block-label eyebrow">Key Subsystem Architecture</div>
        <p>{{keySubsystem}}</p>
      </div>
      <div class="detail-block">
        <div class="detail-block-label eyebrow">Mission Role</div>
        <p>{{missionUse}}</p>
      </div>
      <div class="detail-block">
        <div class="detail-block-label eyebrow">Limitations & Failures</div>
        <p class="red-text">{{limitations}}</p>
      </div>
      <div class="detail-block">
        <div class="detail-block-label eyebrow">Program Lesson</div>
        <blockquote class="detail-quote">"{{programLesson}}"</blockquote>
      </div>
      <div class="detail-block">
        <div class="detail-block-label eyebrow">Future Relevance</div>
        <p>{{futureRelevance}}</p>
      </div>

      {{#if suitFailures.length}}
      <div class="detail-block">
        <div class="detail-block-label eyebrow">Documented Failure Cases</div>
        {{#each suitFailures}}
        <div class="detail-failure-item">
          <div class="detail-failure-header">
            <span class="tag tag-{{severityColor severity}}" style="font-size:.6rem">{{severity}}</span>
            <span class="mono" style="font-size:.65rem;color:var(--paper3)">{{year}}</span>
          </div>
          <p style="font-size:.85rem;margin:.5rem 0">{{failure}}</p>
          <p class="fail-lesson">→ {{lesson}}</p>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </div>
</section>

{{#if related.length}}
<div class="full-bleed-dark">
  <div class="section">
    <div class="eyebrow" style="margin-bottom:1rem">// Related Suits</div>
    <h2 class="sh" style="font-size:1.8rem">Same Program Family</h2>
    <div class="db-grid db-grid--3">
      {{#each related}}{{> suit-card}}{{/each}}
    </div>
  </div>
</div>
{{/if}}
