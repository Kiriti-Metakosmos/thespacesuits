<article class="db-card" data-nation="{{nation}}" data-category="{{category}}" itemscope itemtype="https://schema.org/Product">
  {{#if (eq nation 'us')}}<span class="nation-flag" title="United States"><svg width="20" height="13" viewBox="0 0 20 13"><rect width="20" height="13" fill="#B22234"/><rect y="1" width="20" height="1" fill="white"/><rect y="3" width="20" height="1" fill="white"/><rect y="5" width="20" height="1" fill="white"/><rect y="7" width="20" height="1" fill="white"/><rect y="9" width="20" height="1" fill="white"/><rect y="11" width="20" height="1" fill="white"/><rect width="8" height="7" fill="#3C3B6E"/></svg></span>{{/if}}
  {{#if (eq nation 'soviet')}}<span class="nation-flag" title="Soviet / Russia"><svg width="20" height="13" viewBox="0 0 20 13"><rect width="20" height="4.3" fill="white"/><rect y="4.3" width="20" height="4.3" fill="#0039A6"/><rect y="8.6" width="20" height="4.4" fill="#D52B1E"/></svg></span>{{/if}}
  {{#if (eq nation 'china')}}<span class="nation-flag" title="China"><svg width="20" height="13" viewBox="0 0 20 13"><rect width="20" height="13" fill="#DE2910"/><polygon points="3,2 3.6,4 5.5,4 4,5.1 4.6,7 3,5.9 1.4,7 2,5.1 0.5,4 2.4,4" fill="#FFDE00"/></svg></span>{{/if}}
  {{#if (eq nation 'esa')}}<span class="nation-flag" title="Europe / ESA"><svg width="20" height="13" viewBox="0 0 20 13"><rect width="20" height="13" fill="#003399"/><g fill="#FFCC00" transform="translate(10,6.5)">
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(0) translate(0,-1)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(30) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(60) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(90) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(120) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(150) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(180) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(210) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(240) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(270) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(300) translate(0,-7)"/>
<polygon points="0,-4 0.5,-1.5 3,-1.5 1,-0.2 1.8,2.5 0,1 -1.8,2.5 -1,-0.2 -3,-1.5 -0.5,-1.5" transform="scale(0.5) rotate(330) translate(0,-7)"/>
</g></svg></span>{{/if}}
  <div class="db-card-top">
    <span class="db-card-id mono">{{variantId}}</span>
    <span class="tag tag-{{nationColor nation}}">{{category}}</span>
    {{#if isPrototype}}<span class="tag" style="color:var(--paper3);font-size:.58rem;margin-left:.25rem;letter-spacing:.04em">EXPERIMENTAL</span>{{/if}}
  </div>
  {{#if (hasPhoto slug)}}
  <div style="background:#000;line-height:0;overflow:hidden">
    <img src="/images/suits/{{slug}}.jpg" alt="{{name}} spacesuit photograph" itemprop="image"
         style="display:block;width:100%;max-height:180px;object-fit:contain;background:#000" loading="lazy">
  </div>
  {{else}}
  <div style="background:#000;display:flex;align-items:center;justify-content:center;height:180px;overflow:hidden">
    <svg width="72" height="168" viewBox="0 0 85 198" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" opacity=".35">
      <ellipse cx="42" cy="28" rx="20" ry="24" fill="rgba(255,255,255,.06)" stroke="rgba(255,255,255,.5)" stroke-width="1.4"/>
      <path d="M25 22 Q42 18 59 22 L59 34 Q42 38 25 34Z" fill="rgba(255,255,255,.18)" stroke="rgba(255,255,255,.3)" stroke-width=".8"/>
      <ellipse cx="42" cy="52" rx="14" ry="4" fill="rgba(255,255,255,.18)" stroke="rgba(255,255,255,.5)" stroke-width="1.2"/>
      <rect x="31" y="52" width="22" height="8" rx="2" fill="rgba(255,255,255,.1)" stroke="rgba(255,255,255,.4)" stroke-width="1"/>
      <path d="M20 60 Q18 92 19 128 L65 128 Q66 92 64 60Z" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.5)" stroke-width="1.4"/>
      <rect x="30" y="80" width="24" height="20" rx="2" fill="rgba(255,255,255,.12)" stroke="rgba(255,255,255,.35)" stroke-width=".9"/>
      <circle cx="38" cy="89" r="4.5" fill="rgba(255,255,255,.06)" stroke="rgba(255,255,255,.4)" stroke-width=".7"/>
      <circle cx="50" cy="89" r="4.5" fill="rgba(255,255,255,.06)" stroke="rgba(255,255,255,.4)" stroke-width=".7"/>
      <path d="M20 63 Q8 84 7 112 L17 113 Q20 90 30 67Z" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.4)" stroke-width="1.2"/>
      <ellipse cx="12" cy="112" rx="6" ry="3.5" fill="rgba(255,255,255,.18)" stroke="rgba(255,255,255,.45)" stroke-width="1"/>
      <path d="M64 63 Q76 84 77 112 L67 113 Q64 90 54 67Z" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.4)" stroke-width="1.2"/>
      <ellipse cx="72" cy="112" rx="6" ry="3.5" fill="rgba(255,255,255,.18)" stroke="rgba(255,255,255,.45)" stroke-width="1"/>
      <rect x="20" y="128" width="44" height="9" rx="3" fill="rgba(255,255,255,.18)" stroke="rgba(255,255,255,.5)" stroke-width="1.2"/>
      <path d="M23 137 L20 172 L34 172 L36 137Z" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.4)" stroke-width="1.2"/>
      <path d="M61 137 L64 172 L50 172 L48 137Z" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.4)" stroke-width="1.2"/>
      <path d="M17 172 Q14 180 15 188 L40 188 L39 172Z" fill="rgba(255,255,255,.1)" stroke="rgba(255,255,255,.4)" stroke-width="1"/>
      <ellipse cx="27" cy="188" rx="13" ry="3.5" fill="rgba(255,255,255,.2)" stroke="rgba(255,255,255,.4)" stroke-width=".8"/>
      <path d="M67 172 Q70 180 69 188 L44 188 L45 172Z" fill="rgba(255,255,255,.1)" stroke="rgba(255,255,255,.4)" stroke-width="1"/>
      <ellipse cx="57" cy="188" rx="13" ry="3.5" fill="rgba(255,255,255,.2)" stroke="rgba(255,255,255,.4)" stroke-width=".8"/>
    </svg>
  </div>
  {{/if}}
  <div class="db-card-body">
    <h3 class="db-card-name {{#if isPrototype}}paper2{{else}}{{color}}{{/if}}" itemprop="name">{{name}}</h3>
    <div class="db-card-origin mono" itemprop="brand">{{agency}} · {{manufacturer}}</div>
    <div class="db-card-era">{{era}}</div>
    <div class="db-specs">
      <div class="db-spec">
        <div class="db-spec-key">Pressure</div>
        <div class="db-spec-val mono">{{formatPressure this}}</div>
      </div>
      <div class="db-spec">
        <div class="db-spec-key">System mass</div>
        <div class="db-spec-val mono">{{formatMass this}}</div>
      </div>
      <div class="db-spec">
        <div class="db-spec-key">Life support</div>
        <div class="db-spec-val mono">{{lssPrimary}}</div>
      </div>
      <div class="db-spec">
        <div class="db-spec-key">EVA duration</div>
        <div class="db-spec-val mono">{{formatEVA evaDurationHr}}</div>
      </div>
    </div>
    <p class="db-lesson" itemprop="description">"{{truncate programLesson 140}}"</p>
  </div>
  <a href="/suits/{{slug}}" class="db-card-link" aria-label="View {{name}} technical details">View Full Archive →</a>
</article>
